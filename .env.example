# Copy the relevant keys into /srv/hermes/data/.env. Never commit real values.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
HERMES_UID=10001
HERMES_GID=10001

# Shared model subscriptions or API credentials
CLAUDE_CODE_OAUTH_TOKEN=
OPENROUTER_API_KEY=

# Example agent credentials
FIRECRAWL_MCP_URL=
FIRECRAWL_API_KEY=
SOCIAL_MCP_URL=
SOCIAL_MCP_TOKEN=
NEON_API_KEY=
MONGO_URI=
POSTGRES_URL=

# Public shared file drop. Configure a 30-day lifecycle for prefix shared/.
SHARE_PUBLIC_URL=https://files.example.com
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=temporary-agent-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Private encrypted Restic backup repository. Use a private bucket and keys.
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_BUCKET=hermes-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
RESTIC_PASSWORD=

# Optional generic migration commands. Paths must be explicit absolute paths.
LEGACY_HERMES_DATA=
LEGACY_PLATFORM_ROOT=
CONFIRM_PURGE_V1=
